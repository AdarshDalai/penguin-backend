{
  "name": "penguin-backend",
  "version": "1.0.0",
  "description": "Penguin Express Backend with Supabase Auth and User Profiles",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/core/config/migrations.js",
    "migrate:generate": "npx drizzle-kit generate",
    "migrate:push": "npx drizzle-kit push",
    "studio": "npx drizzle-kit studio"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.7",
    "express": "^4.21.2",
    "pg": "^8.22.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.5"
  }
}
